[global]
	follow = mouse
	format = "<b>%s</b>\n%b"
    origin = bottom-right
 	notification_limit = 5
    timeout = 5
    icon_position = left
    max_icon_size = 48
    frame_width = 2
	frame_color = "#d08770"
    font = "JetBrainsMono Nerd Font Mono 14"
    gap_size = 1
    background = "#1f2531"
    foreground = "#C5C5C6"
    offset = (8, 8)
    corner_radius = 4
    show_indicators = false
    highlight = "#d08770"
