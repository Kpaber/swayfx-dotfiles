*{
	//переменные
	bg-alt: #2e3440 ;
//	main: #8C4566  ;
	main: #d08770;
	txt: #C5C5C6;
	font: "JetBrainsMono NerdFont 14";
	bg: #2e3440 ;
}

window{
//	width: 16%;
//	height: 45%;
//	padding: 20px;
	background-color: @bg;
	border: 4px;
	border-color: @bg;
	border-radius: 4px;
	//spacing: 16px;
//	x-offset: -12;
//	y-offset: 8;	
}

mainbox{
	children: [listview];
	spacing: 4px;
	background-color: @bg;
//	layout: horizontal;
//	border: 4px;
//	border-color: @main;
//	border-radius: 16px;
	padding: 8px;
}


listview{
	children: [element];
	padding: 8px;
	spacing: 20px;
	background-color: @bg;
//	layout: horizontal;
	lines: 7;
	border-radius: 16px;
	
	
}

element{
	border: 4px;
	border-radius: 4px;
	border-color: @bg;
	padding: 4px;
	background-color: @bg;
}

element selected{
	border-color: @main;
}

element-text{
	background-color: @bg;
//	horizontal-align: 0.5;
	text-color: @txt;
}

element-text selected{
//	background-color: @main;
	text-color: @text;
}
