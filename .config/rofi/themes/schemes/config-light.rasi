*{
	//переменные
	txt: #1f2531 ;
//	main: #8C4566  ;
	main: #d08770;
	bg: #eceff4;
	font: "JetBrainsMono NerdFont 14";
	bg-alt: #2e3440 ;
}

configuration{
	show-match: true;
	fixed-num-lines: false;
}

window{
//	width: 16%;
//	height: 45%;
//	padding: 20px;
	background-color: @bg;
	border: 4px;
	border-color: @bg;
	border-radius: 4px;
	//spacing: 16px;
//	x-offset: -12;
	y-offset: 8;	
}

mainbox{
	children: [inputbar, listview];
	spacing: 4px;
	background-color: @bg;
//	layout: horizontal;
//	border: 4px;
//	border-color: @main;
//	border-radius: 16px;
	padding: 8px;
}
inputbar{
	children: [dummy, prompt, dummy];
	background-color: @bg;
}

dummy{
	background-color: @bg;
}

prompt{
	background-color: @bg;
	text-color: @txt;
}

listview{
	children: [element];
	padding: 8px;
	spacing: 4px;
	background-color: @bg;
//	layout: horizontal;
 	lines: 9;
	border-radius: 16px;
	
	
}

element{
	border: 4px;
	border-radius: 4px;
	border-color: @bg;
	padding: 4px;
	background-color: @bg;
}

element selected{
	border-color: @main;
}

element-text{
	background-color: @bg;
//	horizontal-align: 0.5;
	text-color: @txt;
}

element-text selected{
//	background-color: @main;
	text-color: @txt;
}
