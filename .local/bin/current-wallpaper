#!/usr/bin/bash
pkill swaybg
THEME=$(gsettings get org.gnome.desktop.interface color-scheme | tr -d "'")
if [ "$THEME" == "prefer-dark" ]; then
	swaybg -o 'eDP-1' -i /home/kpaber/Изображения/wallpapers/wallhaven-qr3mpq_1920x1080.png -m fill &
	swaybg -o 'HDMI-A-1' -i /home/kpaber/Изображения/wallpapers/wallhaven-qr3mpq_1920x1080.png -m fill &
else
	swaybg -o 'eDP-1' -i /home/kpaber/Изображения/wallpapers/wallhaven-exd3w8_1920x1080.png -m fill &
	swaybg -o 'HDMI-A-1' -i /home/kpaber/Изображения/wallpapers/wallhaven-exd3w8_1920x1080.png -m fill &
fi
	
