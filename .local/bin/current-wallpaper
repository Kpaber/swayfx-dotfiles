#!/usr/bin/bash
pkill swaybg
THEME=$(gsettings get org.gnome.desktop.interface color-scheme | tr -d "'")
if [ "$THEME" == "prefer-dark" ]; then
	swaybg -o 'eDP-1' -i  ~/.local/share/wallpapers/wallpaper-dark.png -m fill &
	swaybg -o 'HDMI-A-1' -i ~/.local/share/wallpapers/wallpaper-dark.png -m fill &
else
	swaybg -o 'eDP-1' -i ~/.local/share/wallpapers/wallpaper-light.png -m fill &
	swaybg -o 'HDMI-A-1' -i ~/.local/share/wallpapers/wallpaper-light.png -m fill &
fi
	
